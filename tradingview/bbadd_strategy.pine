//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// 단타 팜 BBADD 전략 v3 — 딥 진입 + ATR 추매 사다리 + ATR 익절
// 기본값 = AVGDOWN 사전등록 스윕(2026-09-01, 1,248시행)의 [보정 전] 최고 구조:
//   진입 RSI(14)<30 + 종가>SMA200, 추매 간격 1.0×ATR 최대 3회(체결 시 동결·재귀),
//   익절 평단+2.0×ATR(종가 확인형, 마지막 체결 시 동결), 재해 손절 기본 OFF.
//   해당 시행 실측(15m, 5.64년, 수수료+펀딩): 누적 +24.0%, 연 +3.9%, 승률 99.7%,
//   MDD −23.9%. ⚠ 판정: 다중검정 보정 후 1,248개 전부 우연과 구별 불가(RC p=0.76,
//   생존 0) — 이 구조는 "덜 나쁜 노이즈"다. 스윕 실측에서 손절 사용(6/10×ATR)과
//   추매 횟수 증가(0→3회 단조 악화)는 성적을 해쳤다. 관측·학습용, 실거래 신호 아님.
// 같은 봉 익절·추매 동시 성립 시 익절 우선(엔진 elif 동형). 손절 ON 시 T1 체결봉은
// 신호봉 종가 기준 근사 스탑 선발주 후 체결봉 종가에 동결값 교체(추매 갱신 1봉 지연).
// 수수료 편도 0.08% 포함, 펀딩 미포함(엔진 실측은 펀딩 차감 포함 — Tester 가 더 우호적).
// ─────────────────────────────────────────────────────────────────────────────
strategy("단타 팜 BBADD (추매 사다리)", overlay=true,
     initial_capital=10000, currency=currency.USD,
     commission_type=strategy.commission.percent, commission_value=0.08,
     default_qty_type=strategy.percent_of_equity, default_qty_value=8.33,
     pyramiding=4, calc_on_every_tick=false, process_orders_on_close=false)

// ── 입력 ──
entryMode = input.string("RSI<30 (스윕 최고)", "진입 신호", options=["RSI<30 (스윕 최고)", "BB 하단 이탈"])
tpMode    = input.string("평단+n×ATR (스윕 최고)", "익절 기준", options=["평단+n×ATR (스윕 최고)", "BB 중심선"])
lenBB    = input.int(20,   "볼린저 기간")
mulBB    = input.float(2.0,"볼린저 승수")
lenRSI   = input.int(14,   "RSI")
rsiTh    = input.float(30, "RSI 진입 임계")
lenTrend = input.int(200,  "추세 SMA")
useTrend = input.bool(true, "추세 필터 (종가>SMA200 일 때만 진입)")
lenATR   = input.int(24,   "ATR 기간")
addMult  = input.float(1.0,"추매 간격 (×ATR)")
maxAdds  = input.int(3,    "최대 추매 횟수", minval=0, maxval=3)
tpAtrMult = input.float(2.0, "익절 = 평단 + n×ATR")
useStop  = input.bool(false, "재해 손절 사용 — 스윕 실측 열위, 기본 OFF (평단 − n×ATR 동결)")
stopMult = input.float(6.0,  "재해 손절 배수")

// ── 지표 (확정봉 기준 — process_orders_on_close=false 라 신호 확정 후 다음 봉 시가 체결) ──
basis = ta.sma(close, lenBB)
dev   = mulBB * ta.stdev(close, lenBB)
loBB  = basis - dev
rsi   = ta.rsi(close, lenRSI)
smaT  = ta.sma(close, lenTrend)
atr   = ta.atr(lenATR)

// ── 상태: 추매 트리거·손절·익절 (체결 시 동결 — 엔진 #a 규칙) ──
var float nextAdd = na
var float dStop   = na
var float tpRef   = na
newFill = strategy.opentrades > 0 and (strategy.opentrades != strategy.opentrades[1] or strategy.closedtrades > strategy.closedtrades[1])
if newFill
    nextAdd := open - addMult * atr[1]                              // 체결봉 시가 − 직전 확정 ATR (동결)
    dStop   := strategy.position_avg_price - stopMult * atr[1]      // 평단 − n×ATR (동결)
    tpRef   := strategy.position_avg_price + tpAtrMult * atr[1]     // 평단 + n×ATR (동결)

flat = strategy.position_size == 0
if flat
    nextAdd := na
    dStop   := na
    tpRef   := na

// ── 진입: 확정봉 딥 신호 + 추세 필터 (다음 봉 시가 체결) ──
entryRSI = entryMode == "RSI<30 (스윕 최고)"
tpAtrMode = tpMode == "평단+n×ATR (스윕 최고)"
entryHit = entryRSI ? rsi < rsiTh : close < loBB
entrySig = flat and entryHit and (not useTrend or close > smaT)
if entrySig
    strategy.entry("T1", strategy.long)
    // 체결봉 무방비 차단: 신호봉 종가 기준 근사 스탑 선발주 → 체결봉 종가에 동결값 교체
    if useStop
        strategy.exit("SL", stop=close - stopMult * atr)

// ── 청산·추매: 같은 봉 동시 성립 시 익절 우선 (엔진 elif 동형) ──
avgPx = strategy.position_avg_price
tpLv  = tpAtrMode ? tpRef : basis
exitTp = not flat and not na(tpLv) and close >= tpLv
addSig = not flat and not exitTp and not na(nextAdd) and close <= nextAdd and strategy.opentrades <= maxAdds
if addSig
    strategy.entry("T" + str.tostring(strategy.opentrades + 1), strategy.long)
if exitTp
    strategy.close_all(comment=tpAtrMode ? "ATR 익절" : "중심선 익절")
if not flat and useStop
    strategy.exit("SL", stop=dStop)

// ── 표시: 조건 충족 시에만 ──
plotshape(entrySig, "진입 신호", style=shape.labelup, location=location.belowbar, color=color.new(#D9A441, 0), textcolor=color.black, size=size.tiny, text="진입")
pB = plot(basis + dev, "BB 상단", color=color.new(color.gray, 60))
pL = plot(loBB,        "BB 하단", color=color.new(color.gray, 60))
fill(pB, pL, color=color.new(color.gray, 92))
plot(basis, "BB 중심선", color=color.new(color.green, 60))
plot(useTrend ? smaT : na, "SMA200 (추세 필터)", color=color.new(color.orange, 30), linewidth=2)
plot(not flat ? avgPx : na, "평단", color=color.new(#D9A441, 0), linewidth=2, style=plot.style_linebr)
plot(not flat ? tpLv : na,  "익절", color=color.new(color.green, 0), linewidth=2, style=plot.style_linebr)
plot(not flat and useStop ? dStop : na, "손절", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)
plot(not flat and strategy.opentrades <= maxAdds ? nextAdd : na, "다음 추매가", color=color.new(color.blue, 20), style=plot.style_linebr)

var table t = table.new(position.top_right, 2, 5, border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "트랜치", text_size=size.tiny)
    table.cell(t, 1, 0, str.tostring(strategy.opentrades) + "/" + str.tostring(maxAdds + 1), text_size=size.tiny)
    table.cell(t, 0, 1, "평단", text_size=size.tiny)
    table.cell(t, 1, 1, flat ? "—" : str.tostring(avgPx, format.mintick), text_size=size.tiny)
    table.cell(t, 0, 2, "손절/익절", text_size=size.tiny)
    table.cell(t, 1, 2, flat ? "—" : (useStop ? str.tostring(dStop, format.mintick) : "OFF") + " / " + str.tostring(tpLv, format.mintick), text_size=size.tiny)
    table.cell(t, 0, 3, "추세 필터", text_size=size.tiny)
    table.cell(t, 1, 3, useTrend ? (close > smaT ? "통과" : "차단") : "OFF", text_size=size.tiny, text_color=useTrend and close <= smaT ? color.new(color.red, 20) : color.new(color.green, 20))
    table.cell(t, 0, 4, "⚠", text_size=size.tiny)
    table.cell(t, 1, 4, "보정후 유의성 0·신호아님", text_size=size.tiny, text_color=color.new(#D9A441, 0))
