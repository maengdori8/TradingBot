//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// 단타 팜 BBADD 전략 v5 — 딥 진입 + 추매 사다리 + 타이트 손절 + 고정 레버리지 + 24h 캡
// 사용자 요청: 최대 보유 24시간, 레버리지 30~50배 (기본 40배), 최소손해 손절.
// 기본값: 진입 RSI(14)<30 + 종가>SMA200, 추매 1.0×ATR×3(동결·재귀), 익절 평단+2.0×ATR
//   (동결·종가 확인형), 손절 평단−1.0×ATR(동결·봉내 터치), 보유 24시간 초과 시 전량 청산.
// 사이징 기본 = 고정 손실 비율(R-사이징): 수량 = 자본×손실비율 ÷ (진입−손절 거리) — 영상
//   공식 그대로. 레버리지는 결과값(1×ATR 손절·3% 기준 ≈ 12배). 고정 레버리지 모드 선택 가능
//   (단 40배 고정 = 손절당 −10%로 영상의 1~5% 원칙 위반 — 참고). 사다리 4트랜치 공동
//   손절이면 총 손실 ≈ 4×손실비율(영상은 단일 진입 기준 공식).
// ⚠ 수수료 = 편도 0.0375% (바이비트 VIP0 지정가 진입 0.02% + 시장가 청산 0.055% 혼합
//   — 손절·강제청산·시간청산은 시장가 강제. 순수 메이커 왕복 0.04% 는 낙관 상한).
//   40배의 산수: 왕복 0.075%×40 = 자본의 3.0%/거래. 참고: 메이커 4bp 요율로도
//   1,248시행 전수 재검증 결과 생존 0 (PREREGISTRATION_AVGDOWN_FEES) — 요율은 손실
//   속도만 바꾸고 부호를 못 바꾼다.
//   강제청산 거리 ≈ 1/40 − 유지증거금 0.5% = 평단 대비 −2.0% (교차 아닌 격리 근사).
//   TradingView 는 청산을 모델하지 않으므로 본 전략이 청산 근사(liqSim)를 직접 시뮬레이션
//   — 평단 대비 −(1/실효레버리지 − 0.5%) 도달 시 강제 청산 체결. 펀딩 미포함(레버리지
//   배수로 커짐 — 실전은 이 결과보다 더 나쁘다).
// ⚠ 미검증 구조 (스윕 격자 밖). 예측: 수수료 드래그 + 청산·손절 빈발로 순수익 < 0,
//   고배율일수록 악화. Strategy Tester 로 직접 확인하라. 관측·학습용, 실거래 신호 아님.
// ─────────────────────────────────────────────────────────────────────────────
strategy("단타 팜 BBADD (추매 사다리)", overlay=true,
     initial_capital=10000, currency=currency.USD,
     commission_type=strategy.commission.percent, commission_value=0.0375,
     default_qty_type=strategy.percent_of_equity, default_qty_value=8.33,
     pyramiding=4, calc_on_every_tick=false, process_orders_on_close=false)

// ── 입력 ──
entryMode = input.string("RSI<30 (스윕 최고)", "진입 신호", options=["RSI<30 (스윕 최고)", "BB 하단 이탈"])
tpMode    = input.string("평단+n×ATR (스윕 최고)", "익절 기준", options=["평단+n×ATR (스윕 최고)", "BB 중심선"])
sizeMode  = input.string("R-사이징 (리스크%)", "사이징 방식 (영상: 고정 손실 비율)", options=["고정 레버리지", "R-사이징 (리스크%)"])
levTarget = input.float(40.0, "목표 레버리지 (×자본, 30~50)", minval=1, maxval=50)
riskPct   = input.float(3.0,  "고정 손실 비율 (자본 %/트랜치, 영상 권장 1~5%)", minval=0.1, maxval=10)
holdHours = input.float(24.0, "최대 보유 시간 (시간)", minval=1, maxval=168)
liqSim    = input.bool(true,  "강제청산 근사 (유지증거금 0.5%)")
lenBB    = input.int(20,   "볼린저 기간")
mulBB    = input.float(2.0,"볼린저 승수")
lenRSI   = input.int(14,   "RSI")
rsiTh    = input.float(30, "RSI 진입 임계")
lenTrend = input.int(200,  "추세 SMA")
useTrend = input.bool(true, "추세 필터 (종가>SMA200 일 때만 진입)")
lenATR   = input.int(24,   "ATR 기간")
addMult  = input.float(1.0,"추매 간격 (×ATR)")
maxAdds  = input.int(3,    "최대 추매 횟수", minval=0, maxval=3)
tpAtrMult = input.float(2.0, "익절 = 평단 + n×ATR")
useStop  = input.bool(true,  "타이트 손절 (평단 − n×ATR 동결)")
stopMult = input.float(1.0,  "손절 배수 (×ATR, 최소손해)")

MAINT = 0.005     // 유지증거금 근사 0.5%

// ── 지표 (확정봉 기준 — process_orders_on_close=false 라 신호 확정 후 다음 봉 시가 체결) ──
basis = ta.sma(close, lenBB)
dev   = mulBB * ta.stdev(close, lenBB)
loBB  = basis - dev
rsi   = ta.rsi(close, lenRSI)
smaT  = ta.sma(close, lenTrend)
atr   = ta.atr(lenATR)

// ── 상태: 추매 트리거·손절·익절·보유시각 (체결 시 동결 — 엔진 #a 규칙) ──
var float nextAdd = na
var float dStop   = na
var float tpRef   = na
var int   posT0   = na
newFill = strategy.opentrades > 0 and (strategy.opentrades != strategy.opentrades[1] or strategy.closedtrades > strategy.closedtrades[1])
if newFill
    nextAdd := open - addMult * atr[1]                              // 체결봉 시가 − 직전 확정 ATR (동결)
    dStop   := strategy.position_avg_price - stopMult * atr[1]      // 평단 − n×ATR (동결·추매 시 이동)
    tpRef   := strategy.position_avg_price + tpAtrMult * atr[1]     // 평단 + n×ATR (동결)
    if na(posT0)
        posT0 := time                                               // 최초 체결봉 시각 (보유시간 기준)

flat = strategy.position_size == 0
if flat
    nextAdd := na
    dStop   := na
    tpRef   := na
    posT0   := na

// ── 사이징: 고정 레버리지 (기본) 또는 R-사이징 ──
f_qty() =>
    float q = na
    if sizeMode == "고정 레버리지"
        q := strategy.equity * levTarget / 4 / close                // 트랜치 명목 = 목표×자본/4
    else
        stopDist = stopMult * atr
        q := useStop and stopDist > 0 ? strategy.equity * riskPct / 100 / stopDist : strategy.equity * 0.0833 / close
    math.min(q, strategy.equity * 50.0 / 4 / close)                 // 절대 상한 50배

// ── 강제청산 근사: 평단 × (1 − 1/실효레버리지 + 유지증거금) ──
avgPx = strategy.position_avg_price
posNom = math.abs(strategy.position_size) * avgPx
levEff = flat or strategy.equity <= 0 ? na : posNom / strategy.equity
liqPx  = flat or na(levEff) or levEff <= 0 ? na : avgPx * (1 - 1 / levEff + MAINT)

// ── 진입: 확정봉 딥 신호 + 추세 필터 (다음 봉 시가 체결) ──
entryRSI = entryMode == "RSI<30 (스윕 최고)"
tpAtrMode = tpMode == "평단+n×ATR (스윕 최고)"
entryHit = entryRSI ? rsi < rsiTh : close < loBB
entrySig = flat and entryHit and (not useTrend or close > smaT)
if entrySig
    strategy.entry("T1", strategy.long, qty=f_qty())
    // 체결봉 무방비 차단: 신호봉 종가 기준 근사 스탑 선발주 → 체결봉 종가에 동결값 교체
    if useStop
        strategy.exit("SL", stop=close - stopMult * atr)

// ── 청산·추매: 같은 봉 동시 성립 시 익절 우선 (엔진 elif 동형) ──
tpLv  = tpAtrMode ? tpRef : basis
exitTp = not flat and not na(tpLv) and close >= tpLv
exitTime = not flat and not na(posT0) and (time - posT0) >= holdHours * 3600000
addSig = not flat and not exitTp and not exitTime and not na(nextAdd) and close <= nextAdd and strategy.opentrades <= maxAdds
if addSig
    strategy.entry("T" + str.tostring(strategy.opentrades + 1), strategy.long, qty=f_qty())
if exitTp
    strategy.close_all(comment=tpAtrMode ? "ATR 익절" : "중심선 익절")
if exitTime and not exitTp
    strategy.close_all(comment="24h 시간 청산")
// 손절·청산 스탑: 더 가까운(높은) 쪽이 지배
effStop = useStop and liqSim ? math.max(nz(dStop, liqPx), nz(liqPx, dStop)) : useStop ? dStop : liqSim ? liqPx : na
if not flat and not na(effStop)
    strategy.exit("SL", stop=effStop)

// ── 표시: 조건 충족 시에만 ──
plotshape(entrySig, "진입 신호", style=shape.labelup, location=location.belowbar, color=color.new(#D9A441, 0), textcolor=color.black, size=size.tiny, text="진입")
pB = plot(basis + dev, "BB 상단", color=color.new(color.gray, 60))
pL = plot(loBB,        "BB 하단", color=color.new(color.gray, 60))
fill(pB, pL, color=color.new(color.gray, 92))
plot(basis, "BB 중심선", color=color.new(color.green, 60))
plot(useTrend ? smaT : na, "SMA200 (추세 필터)", color=color.new(color.orange, 30), linewidth=2)
plot(not flat ? avgPx : na, "평단", color=color.new(#D9A441, 0), linewidth=2, style=plot.style_linebr)
plot(not flat ? tpLv : na,  "익절", color=color.new(color.green, 0), linewidth=2, style=plot.style_linebr)
plot(not flat and useStop ? dStop : na, "손절(타이트)", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)
plot(not flat and liqSim ? liqPx : na, "강제청산(근사)", color=color.new(color.fuchsia, 0), linewidth=2, style=plot.style_linebr)
plot(not flat and strategy.opentrades <= maxAdds ? nextAdd : na, "다음 추매가", color=color.new(color.blue, 20), style=plot.style_linebr)

var table t = table.new(position.top_right, 2, 7, border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "트랜치", text_size=size.tiny)
    table.cell(t, 1, 0, str.tostring(strategy.opentrades) + "/" + str.tostring(maxAdds + 1), text_size=size.tiny)
    table.cell(t, 0, 1, "평단", text_size=size.tiny)
    table.cell(t, 1, 1, flat ? "—" : str.tostring(avgPx, format.mintick), text_size=size.tiny)
    table.cell(t, 0, 2, "손절/익절", text_size=size.tiny)
    table.cell(t, 1, 2, flat ? "—" : (useStop ? str.tostring(dStop, format.mintick) : "OFF") + " / " + str.tostring(tpLv, format.mintick), text_size=size.tiny)
    table.cell(t, 0, 3, "명목/자본", text_size=size.tiny)
    table.cell(t, 1, 3, flat ? "—" : str.tostring(levEff, "#.#") + "x", text_size=size.tiny, text_color=levEff > 25 ? color.new(color.red, 0) : color.new(color.gray, 20))
    table.cell(t, 0, 4, "청산가(근사)", text_size=size.tiny)
    table.cell(t, 1, 4, flat or not liqSim ? "—" : str.tostring(liqPx, format.mintick), text_size=size.tiny, text_color=color.new(color.fuchsia, 0))
    table.cell(t, 0, 5, "추세 필터", text_size=size.tiny)
    table.cell(t, 1, 5, useTrend ? (close > smaT ? "통과" : "차단") : "OFF", text_size=size.tiny, text_color=useTrend and close <= smaT ? color.new(color.red, 20) : color.new(color.green, 20))
    table.cell(t, 0, 6, "⚠", text_size=size.tiny)
    table.cell(t, 1, 6, "미검증·왕복비용 " + str.tostring(0.075 * levTarget, "#.#") + "%/거래", text_size=size.tiny, text_color=color.new(#D9A441, 0))
