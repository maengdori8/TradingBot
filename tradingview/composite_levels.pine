//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// 단타 팜 컴포짓 지표 v3 — 신호 게이트 레벨 (조건 충족 시에만 진입·손절·익절·추매 표시)
// 기본 신호·레벨 = AVGDOWN 스윕(사전등록 2026-09-01, 1,248시행)의 [보정 전] 최고 구조:
//   진입 RSI(14)<30 + 종가>SMA200, 추매 진입−1/2/3×ATR, 익절 평단+2.0×ATR, 손절 없음.
//   해당 시행 실측(15m, 5.64년): 누적 +24.0%, 연 +3.9%, 승률 99.7%, MDD −23.9%.
// ⚠ 판정: 다중검정 보정 후 1,248개 전부 우연과 구별 불가 (RC p=0.76, 생존 0) —
//   이 구조는 "덜 나쁜 노이즈"이며 검증된 엣지가 아니다. 관측·학습용, 매매 신호 아님.
// 신호 확정 시 레벨 동결: 진입=신호봉 종가(다음 봉 시가 체결 근사), 손절=진입−1×ATR
// (사용자 요청 타이트 손절 — 스윕 격자 밖·미검증. 넓은 손절 6/10×ATR 은 실측 열위였고
//  타이트 손절은 손절 빈발이 예상됨), 익절=진입+2.0×ATR
// (또는 BB 중심선 옵션), 추매=진입−1/2/3×ATR. 플랜 종료: 종가 익절 확인 / 손절선 터치 /
// 타임아웃(기본 96봉). 상태 갱신은 확정봉에서만(리페인트 방지). 알림은 플랜 생성 시에만.
// 근사 공개: 추매2·3·손절·익절은 재동결(실체결가·체결시점 ATR) 미반영, 익절 기준 평단은
// 진입가로 근사(실제 평단은 추매 시 하락). 게이지 테이블은 진행 중 봉 값.
// 컴포짓 게이지는 대시보드 동결 산식(예측력 우연 수준 — SWEEP-2026-08-31).
// ─────────────────────────────────────────────────────────────────────────────
indicator("단타 팜 컴포짓 · 레벨", overlay=true)

// ── 입력 ──
entryMode = input.string("RSI<30 (스윕 최고)", "진입 신호", options=["RSI<30 (스윕 최고)", "BB 하단 이탈"])
tpMode    = input.string("평단+2.0×ATR (스윕 최고)", "익절 기준", options=["평단+2.0×ATR (스윕 최고)", "BB 중심선"])
lenBB    = input.int(20,  "볼린저 기간")
mulBB    = input.float(2.0, "볼린저 승수")
lenFast  = input.int(20,  "SMA fast")
lenSlow  = input.int(200, "SMA slow (추세 필터)")
lenRSI   = input.int(14,  "RSI")
rsiTh    = input.float(30, "RSI 진입 임계")
lenATR   = input.int(24,  "ATR (손절·추매·익절)")
chFast   = input.int(24,  "돌파 채널 (컴포짓용)")
stopMult = input.float(1.0, "손절 = 진입 − n×ATR (최소손해 타이트)")
addMult  = input.float(1.0, "추매 간격 (×ATR)")
maxAdds  = input.int(3,   "추매 단수", minval=1, maxval=3)
tpAtrMult = input.float(2.0, "익절 = 진입 + n×ATR")
planBars = input.int(96,  "플랜 유지 최대 봉수")

// ── 지표 (엔진 동일식: 확정봉 기준 — Pine 은 기본이 확정봉) ──
basis = ta.sma(close, lenBB)
dev   = mulBB * ta.stdev(close, lenBB)          // ddof=0 동일 (Pine stdev = 모표준편차)
upBB  = basis + dev
loBB  = basis - dev
smaF  = ta.sma(close, lenFast)
smaS  = ta.sma(close, lenSlow)
rsi   = ta.rsi(close, lenRSI)
atr   = ta.atr(lenATR)                          // Wilder RMA — 엔진과 동일 평활
chHi  = ta.highest(high, chFast)[1]             // 직전 N봉 (shift 1 — 룩어헤드 방지)
volAvg = ta.sma(volume, 20)[1]

// ── 컴포짓 −100~+100 (대시보드 동결 산식 이식 — na/0 은 대시보드처럼 중립 0) ──
f_clip(x, lim) => math.max(-lim, math.min(lim, x))
alignW  = smaF > smaS ? 5 : smaF < smaS ? -5 : 0
trendRaw = f_clip((close / smaS - 1) * 100, 10) * 1.5 + alignW
cTrend  = f_clip(trendRaw, 20)
cMom    = f_clip((rsi - 50) * 0.4, 20)
pctB    = (upBB - loBB) > 0 ? (close - loBB) / (upBB - loBB) : 0.5
cBand   = f_clip((0.5 - pctB) * 40, 20)
surge   = volAvg > 0 ? volume / volAvg : 1.0
cVol    = surge > 0 ? f_clip(math.log(surge) / math.log(2) * 10, 20) : 0.0
dBrk    = chHi > 0 ? (chHi - close) / close * 100 : na
cBrk    = na(dBrk) ? 0 : (dBrk <= 0 ? 20.0 : 20.0 / (1 + dBrk))
score   = f_clip(nz(cTrend) + nz(cMom) + nz(cBand) + nz(cVol) + nz(cBrk), 100)

// ── 신호: 진입 모드 + 추세 필터 (확정봉) ──
entryRSI = entryMode == "RSI<30 (스윕 최고)"
tpAtr    = tpMode == "평단+2.0×ATR (스윕 최고)"
entryHit = entryRSI ? rsi < rsiTh : close < loBB
buySetup = not na(rsi) and not na(loBB) and not na(smaS) and not na(atr) and entryHit and close > smaS

// ── 플랜 상태 — 확정봉에서만 갱신 (리페인트 방지) ──
var bool  pActive = false
var float pEntry = na
var float pStop  = na
var float pTP    = na
var float pAdd1  = na
var float pAdd2  = na
var float pAdd3  = na
var int   pStart = 0
newPlan = false
endStop = false
endTP   = false
endTime = false
if barstate.isconfirmed
    if pActive
        if low <= pStop
            endStop := true
            pActive := false
        else if tpAtr ? close >= pTP : close >= basis
            endTP := true
            pActive := false
        else if bar_index - pStart >= planBars
            endTime := true
            pActive := false
    if not pActive and buySetup
        pActive := true
        newPlan := true
        pStart := bar_index
        pEntry := close
        pStop  := close - stopMult * atr
        pTP    := tpAtr ? close + tpAtrMult * atr : basis
        pAdd1  := close - 1 * addMult * atr
        pAdd2  := close - 2 * addMult * atr
        pAdd3  := close - 3 * addMult * atr

// ── 컨텍스트 오버레이 ──
pB = plot(upBB, "BB 상단", color=color.new(color.gray, 60))
pL = plot(loBB, "BB 하단", color=color.new(color.gray, 60))
fill(pB, pL, color=color.new(color.gray, 92))
plot(basis, "BB 중심", color=color.new(color.silver, 40))
plot(smaS,  "SMA200 (추세 필터)", color=color.new(color.orange, 30), linewidth=2)

// ── 신호 게이트 레벨 (플랜 활성 시에만 표시) ──
plot(pActive ? pEntry : na, "진입", color=color.new(#D9A441, 0), linewidth=2, style=plot.style_linebr)
plot(pActive ? pStop  : na, "손절(타이트)", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)
plot(pActive ? pTP    : na, "익절", color=color.new(color.green, 0), linewidth=2, style=plot.style_linebr)
plot(pActive and maxAdds >= 1 ? pAdd1 : na, "추매1", color=color.new(color.blue, 20), style=plot.style_linebr)
plot(pActive and maxAdds >= 2 ? pAdd2 : na, "추매2", color=color.new(color.blue, 40), style=plot.style_linebr)
plot(pActive and maxAdds >= 3 ? pAdd3 : na, "추매3", color=color.new(color.blue, 55), style=plot.style_linebr)
plotshape(newPlan, "진입 신호", style=shape.labelup, location=location.belowbar, color=color.new(#D9A441, 0), textcolor=color.black, size=size.tiny, text="진입")
plotshape(endStop, "플랜 종료(손절선)", style=shape.xcross, location=location.belowbar, color=color.new(color.red, 0), size=size.tiny)
plotshape(endTP,   "플랜 종료(익절)", style=shape.circle, location=location.abovebar, color=color.new(color.green, 0), size=size.tiny)
plotshape(endTime, "플랜 종료(타임아웃)", style=shape.xcross, location=location.abovebar, color=color.new(color.gray, 30), size=size.tiny)
alertcondition(newPlan, "단타 팜 진입 조건 충족", "단타 팜: 진입 조건 + 추세 필터 — 플랜 생성 (관측용·신호아님)")

// ── 게이지 + 플랜 테이블 ──
var table t = table.new(position.top_right, 2, 10, border_width=1)
if barstate.islast
    col = score > 15 ? color.new(color.green, 60) : score < -15 ? color.new(color.red, 60) : color.new(color.gray, 60)
    table.cell(t, 0, 0, "컴포짓", bgcolor=color.new(color.black, 40), text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, str.tostring(score, "#"), bgcolor=col, text_color=color.white, text_size=size.small)
    table.cell(t, 0, 1, "추세", text_size=size.tiny)
    table.cell(t, 1, 1, str.tostring(nz(cTrend), "#.#"), text_size=size.tiny)
    table.cell(t, 0, 2, "모멘텀", text_size=size.tiny)
    table.cell(t, 1, 2, str.tostring(nz(cMom), "#.#"), text_size=size.tiny)
    table.cell(t, 0, 3, "밴드", text_size=size.tiny)
    table.cell(t, 1, 3, str.tostring(nz(cBand), "#.#"), text_size=size.tiny)
    table.cell(t, 0, 4, "거래량", text_size=size.tiny)
    table.cell(t, 1, 4, str.tostring(nz(cVol), "#.#"), text_size=size.tiny)
    table.cell(t, 0, 5, "RSI", text_size=size.tiny)
    table.cell(t, 1, 5, str.tostring(rsi, "#.#"), text_size=size.tiny, text_color=rsi < rsiTh ? color.new(#D9A441, 0) : color.new(color.gray, 20))
    table.cell(t, 0, 6, "플랜", text_size=size.tiny, bgcolor=color.new(color.black, 40), text_color=color.white)
    table.cell(t, 1, 6, pActive ? "활성" : "관망", text_size=size.tiny, bgcolor=pActive ? color.new(#D9A441, 40) : color.new(color.gray, 70), text_color=color.white)
    table.cell(t, 0, 7, "진입/손절", text_size=size.tiny)
    table.cell(t, 1, 7, pActive ? str.tostring(pEntry, format.mintick) + " / " + str.tostring(pStop, format.mintick) : "—", text_size=size.tiny)
    table.cell(t, 0, 8, "익절/추매1", text_size=size.tiny)
    table.cell(t, 1, 8, pActive ? str.tostring(pTP, format.mintick) + " / " + str.tostring(pAdd1, format.mintick) : "—", text_size=size.tiny)
    table.cell(t, 0, 9, "⚠", text_size=size.tiny)
    table.cell(t, 1, 9, "보정후 유의성 0·신호아님", text_size=size.tiny, text_color=color.new(#D9A441, 0))
