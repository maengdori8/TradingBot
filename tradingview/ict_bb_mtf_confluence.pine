string GROUP_RISK = "리스크"
string GROUP_DISPLAY = "표시"

int minScore = input.int(3, "ICT 최소 내부 점수", minval = 2, maxval = 12, group = GROUP_SIGNAL, tooltip = "전체 100점 합의 전, ICT 근거가 최소한 존재하는지 확인합니다.", display = display.data_window)
int setupWindow = input.int(5, "셋업 유효 봉 수", minval = 1, maxval = 20, group = GROUP_SIGNAL, display = display.data_window)
