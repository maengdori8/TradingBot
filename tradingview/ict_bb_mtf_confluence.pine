int atrLength = input.int(14, "ATR 길이", minval = 2, maxval = 50, group = GROUP_ICT, display = display.data_window)
float displacementAtr = input.float(0.8, "변위 캔들 최소 ATR", minval = 0.2, maxval = 3.0, step = 0.1, group = GROUP_ICT, display = display.data_window)
bool showEma = input.bool(false, "EMA 20·50·200 (디버그)", group = GROUP_TREND, display = display.data_window)
