int stochLength = input.int(14, "스토캐스틱 길이", minval = 3, maxval = 50, group = GROUP_MOMENTUM, display = display.data_window)
int stochSmoothK = input.int(3, "%K 평활", minval = 1, maxval = 10, group = GROUP_MOMENTUM, display = display.data_window)
int stochSmoothD = input.int(3, "%D 평활", minval = 1, maxval = 10, group = GROUP_MOMENTUM, display = display.data_window)
