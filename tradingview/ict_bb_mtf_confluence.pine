//@version=6
indicator("ICT Technical Execution Overlay [1m/5m/15m]", shorttitle = "ICT EXEC", overlay = true, max_labels_count = 200, max_lines_count = 300, max_boxes_count = 300)

// 이 지표의 점수와 방향은 수익 확률이 아니라 서로 다른 근거의 일치도를 뜻합니다.
// 신호는 차트 봉 마감 후 확정되며, 상위 타임프레임은 직전 확정봉만 사용합니다.

string GROUP_SIGNAL = "신호"
string GROUP_BB = "볼린저 밴드"
string GROUP_MOMENTUM = "모멘텀"
string GROUP_ICT = "ICT"
string GROUP_TREND = "추세·강도"
string GROUP_VOLUME = "거래량·매물대"
