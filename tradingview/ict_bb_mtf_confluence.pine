float supertrendFactor = input.float(3.0, "Supertrend 배수", minval = 1.0, maxval = 10.0, step = 0.1, group = GROUP_TREND, display = display.data_window)
int supertrendAtrLength = input.int(10, "Supertrend ATR", minval = 2, maxval = 50, group = GROUP_TREND, display = display.data_window)
bool showVolumeProfile = input.bool(false, "근사 고정구간 매물대 (디버그)", group = GROUP_VOLUME, tooltip = "차트 OHLCV를 가격 구간에 균등 배분한 근사값입니다. TradingView 내장 Volume Profile과 동일하지 않습니다.", display = display.data_window)
int profileLookback = input.int(240, "매물대 조회 봉", minval = 50, maxval = 1000, group = GROUP_VOLUME, display = display.data_window)
