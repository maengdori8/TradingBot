bool showSupertrend = input.bool(false, "Supertrend", group = GROUP_TREND, display = display.data_window)
int emaFastLength = input.int(20, "빠른 EMA", minval = 2, maxval = 100, group = GROUP_TREND, display = display.data_window)
int emaTrendLength = input.int(50, "추세 EMA", minval = 5, maxval = 200, group = GROUP_TREND, display = display.data_window)
