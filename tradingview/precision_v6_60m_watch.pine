//@version=6
indicator(
     "DISCOVERY FAIL — Precision V6 External-Funding WATCH [60m]",
     shorttitle = "PV6 60",
     overlay = true,
     calc_bars_count = 50000,
     max_labels_count = 100)

// VALIDATION / DISCOVERY STATUS: FAIL — RESEARCH·PAPER WATCH ONLY.
// 이 스크립트는 주문 실행 권위가 없고 수익을 보장하지 않는다. 외부 거래소의 실제
// 72시간 펀딩 누계가 0.0004 이하인지 Pine에서 알 수 없으므로 그 조건을 가격으로
// 대체하거나 통과한 것처럼 표시하지 않는다. 모든 alert는 execution_authority=false,
// actionable=false이며 ENTRY가 아니라 WATCH다. 표준 60분봉의 확정 종가에서만 신호를
// 만들고, 다음 60분봉 시가를 단지 계획 기준가로 사용한다.
//
// A+ 가격 게이트:
// - V5 CORE: 이전 24h high 종가돌파, 이전 SMA200/RSI14/volume 게이트
// - 현재 후보를 제외한 [t-365D,t) raw-breakout ATR/close 선형 q60, full365, min30
// - 24h 수익률 >= 2%, 상승 몸통 >= 0.75 * ATR24[1]
// - 같은 확정시각의 BTC 168h 수익률 >= 0
// HIGH WATCH는 선택적 Pine-only 관찰 태그이며 검증 승격이 아니다.

int HOUR_MS = 60 * 60 * 1000
int DAY_MS = 24 * HOUR_MS
int WINDOW_MS = 365 * DAY_MS
float STOP_ATR = 7.0
float TAKE_PROFIT_R = 1.0
int PLAN_HOURS = 24
float EXTERNAL_FUNDING_MAX_72H = 0.0004

string btcTicker = input.symbol("BYBIT:BTCUSDT.P", "확정 BTC 레짐 심볼", display = display.data_window)
bool enableHighWatch = input.bool(false, "Pine-only HIGH WATCH 관찰", tooltip = "기본 A+ WATCH에는 영향을 주지 않는 선택 옵션입니다. BTC>SMA200 및 자체 DMI spread 2봉>=20을 추가하지만 실행 신호가 아닙니다.", display = display.data_window)
bool enableObservationAlerts = input.bool(true, "WATCH 관찰 알림", tooltip = "execution_authority=false인 외부 펀딩 확인 요청만 보냅니다.", display = display.data_window)

bool validTimeframe = timeframe.isminutes and timeframe.multiplier == 60
if barstate.isfirst and not validTimeframe
    runtime.error("Precision V6 WATCH는 표준 60분봉에서만 사용할 수 있습니다.")
if barstate.isfirst and not chart.is_standard
    runtime.error("Heikin Ashi/Renko 등 비표준 차트에서는 사용할 수 없습니다.")

f_boolJson(bool value) =>
    value ? "true" : "false"

f_numJson(float value) =>
    na(value) ? "null" : str.tostring(value, "#.########")

f_linearQuantile(array<float> values, float quantile) =>
    float result = na
    int count = array.size(values)
    if count > 0
        array<float> ordered = array.copy(values)
        array.sort(ordered, order.ascending)
        float rank = (count - 1) * quantile
        int lowerIndex = int(math.floor(rank))
        int upperIndex = int(math.ceil(rank))
        float lowerValue = array.get(ordered, lowerIndex)
        float upperValue = array.get(ordered, upperIndex)
        result := lowerValue + (upperValue - lowerValue) * (rank - lowerIndex)
    result

// pandas rolling("365D", closed="left")처럼 왼쪽 경계시각은 포함한다.
f_trimWindow(array<int> timestamps, array<float> values, int cutoff) =>
    while array.size(timestamps) > 0
        if array.get(timestamps, 0) < cutoff
            array.shift(timestamps)
            array.shift(values)
        else
            break
    true

f_contextGrade(int score) =>
    score >= 7 ? "A" : score >= 5 ? "B" : "C"

f_btcCurrentBundle() =>
    float btcTrend = ta.sma(close, 200)
    float btcRet168 = not na(close[168]) and close[168] != 0.0 ? close / close[168] - 1.0 : na
    [btcRet168, close > btcTrend]

f_watchJson(
     string setupId,
     string eventId,
     string watchGrade,
     int signalTime,
     float signalClose,
     float referenceOpen,
     float atr,
     float threshold,
     int samples,
     float finalStop,
     float add1,
     float add2,
     float add3,
     float add4,
     float takeProfit,
     int contextScore,
     bool ictSweep,
     bool ictFvg,
     bool ictOb,
     bool ictOte,
     bool bbPass,
     float rsiValue,
     float dmiSpread,
     float adxValue,
     float volumeRatio,
     bool profilePass) =>
    "{\"version\":\"precision_v6\",\"validation_status\":\"DISCOVERY_FAIL\"" +
     ",\"execution_authority\":false,\"actionable\":false,\"watch_only\":true" +
     ",\"event\":\"external_funding_watch\",\"event_id\":\"" + eventId + "\"" +
     ",\"setup_id\":\"" + setupId + "\",\"watch_grade\":\"" + watchGrade + "\"" +
     ",\"ticker\":\"" + syminfo.tickerid + "\",\"signal_timeframe\":\"60\"" +
     ",\"signal_time\":" + str.tostring(signalTime) + ",\"signal_close\":" + f_numJson(signalClose) +
     ",\"price_gate_pass\":true,\"external_funding_required\":true" +
     ",\"external_funding_observed\":null,\"external_funding_max_72h\":" + f_numJson(EXTERNAL_FUNDING_MAX_72H) +
     ",\"external_funding_rule\":\"actual_72h_cumulative_rate_lte_0.0004\"" +
     ",\"plan\":{\"reference\":\"next_60m_open_watch_only\",\"reference_open\":" + f_numJson(referenceOpen) +
     ",\"add_plan_validated\":false,\"final_sl\":" + f_numJson(finalStop) + ",\"add_20\":" + f_numJson(add1) +
     ",\"add_40\":" + f_numJson(add2) + ",\"add_60\":" + f_numJson(add3) +
     ",\"add_80\":" + f_numJson(add4) + ",\"take_profit_1r\":" + f_numJson(takeProfit) +
     ",\"review_hours\":24,\"max_additions\":4}" +
     ",\"model\":{\"atr24_entry\":" + f_numJson(atr) + ",\"q60_threshold\":" + f_numJson(threshold) +
     ",\"q60_prior_samples\":" + str.tostring(samples) + "}" +
     ",\"context\":{\"score\":" + str.tostring(contextScore) + ",\"grade\":\"" + f_contextGrade(contextScore) + "\"" +
     ",\"ict_sweep\":" + f_boolJson(ictSweep) + ",\"ict_fvg\":" + f_boolJson(ictFvg) +
     ",\"ict_ob_proxy\":" + f_boolJson(ictOb) + ",\"ict_ote_proxy\":" + f_boolJson(ictOte) +
     ",\"bb_upper_break\":" + f_boolJson(bbPass) + ",\"rsi14\":" + f_numJson(rsiValue) +
     ",\"dmi_spread\":" + f_numJson(dmiSpread) + ",\"adx14\":" + f_numJson(adxValue) +
     ",\"volume_ratio\":" + f_numJson(volumeRatio) + ",\"volume_profile_proxy_pass\":" + f_boolJson(profilePass) + "}}"

// 모든 TA series는 매 계산에서 평가한다. 주문·체결 상태는 전혀 만들지 않는다.
float trend = ta.sma(close, 200)
float momentum = ta.rsi(close, 14)
float volumeAverage = ta.sma(volume, 20)
float atrEntry = ta.atr(24)[1]
float entryHigh = ta.highest(high, 24)[1]
float entryLow = ta.lowest(low, 24)[1]
bool priorLongGate = close[1] > trend[1] and momentum[1] > 50.0 and volume[1] > volumeAverage[2]
bool featureReady = not na(atrEntry) and not na(entryHigh) and not na(entryLow) and not na(trend[1]) and not na(momentum[1]) and not na(volumeAverage[2])
bool coreRaw = featureReady and priorLongGate and close > entryHigh
float relativeAtr = atrEntry / close

float ret24 = not na(close[24]) and close[24] != 0.0 ? close / close[24] - 1.0 : na
bool ret24Pass = not na(ret24) and ret24 >= 0.02
bool bullishBodyPass = close > open and close - open >= 0.75 * atrEntry

[plusDi, minusDi, adxValue] = ta.dmi(14, 14)
float dmiSpread = plusDi - minusDi
float volumeRatio = volumeAverage[1] > 0.0 ? volume / volumeAverage[1] : na
float bbBasis = ta.sma(close, 20)
float bbDeviation = 2.0 * ta.stdev(close, 20)
bool bbPass = close > bbBasis + bbDeviation
float priorLiquidityLow = ta.lowest(low, 5)[1]
bool ictSweep = low < priorLiquidityLow and close > priorLiquidityLow
bool ictFvg = low > high[2]
bool ictOb = close[1] < open[1] and close > high[1]
float oteHigh = ta.highest(high, 24)[1]
float oteLow = ta.lowest(low, 24)[1]
float oteRange = oteHigh - oteLow
float oteLower = oteHigh - oteRange * 0.786
float oteUpper = oteHigh - oteRange * 0.618
bool ictOte = oteRange > 0.0 and low >= oteLower and low <= oteUpper and close > open
float profileProxy = ta.sma(hlc3 * volume, 48) / ta.sma(volume, 48)
bool profilePass = not na(profileProxy) and close >= profileProxy
bool rsiContextPass = momentum >= 60.0
bool dmiContextPass = dmiSpread >= 20.0 and adxValue >= 20.0
bool volumeContextPass = not na(volumeRatio) and volumeRatio >= 1.20
int contextScore = (ictSweep ? 1 : 0) + (ictFvg ? 1 : 0) + (ictOb ? 1 : 0) + (ictOte ? 1 : 0) + (bbPass ? 1 : 0) + (rsiContextPass ? 1 : 0) + (dmiContextPass ? 1 : 0) + (volumeContextPass ? 1 : 0) + (profilePass ? 1 : 0)

// 같은 60분 종가에서 확정된 BTC 값만 쓴다. lookahead_off의 현재 값은 이 스크립트가
// barstate.isconfirmed일 때만 게이트에 사용하므로 진행 중 BTC 봉으로 WATCH를 만들지 않는다.
[btcRet168, btcSmaBull] = request.security(
     btcTicker,
     "60",
     f_btcCurrentBundle(),
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_off,
     calc_bars_count = 50000)

var array<int> candidateTimes = array.new_int()
var array<float> candidateVolatility = array.new_float()
var int firstFeatureReadyTime = na
var int lastProcessedHour = na

float coreThreshold = na
int coreSamples = array.size(candidateVolatility)
bool coreFullWindow = false
bool coreAccepted = false

bool processHour = barstate.isconfirmed and (na(lastProcessedHour) or time != lastProcessedHour)
if processHour
    if featureReady and na(firstFeatureReadyTime)
        firstFeatureReadyTime := time
    f_trimWindow(candidateTimes, candidateVolatility, time - WINDOW_MS)
    coreSamples := array.size(candidateVolatility)
    coreFullWindow := not na(firstFeatureReadyTime) and time >= firstFeatureReadyTime + WINDOW_MS
    coreThreshold := coreRaw and coreFullWindow and coreSamples >= 30 ? f_linearQuantile(candidateVolatility, 0.60) : na
    coreAccepted := coreRaw and not na(coreThreshold) and relativeAtr <= coreThreshold
    // 현재 raw 후보는 threshold 판정이 끝난 뒤에만 과거 원장으로 들어간다.
    if coreRaw and not na(relativeAtr)
        array.push(candidateTimes, time)
        array.push(candidateVolatility, relativeAtr)
    lastProcessedHour := time

bool btcRetPass = not na(btcRet168) and btcRet168 >= 0.0
bool priceGatePass = processHour and coreAccepted and ret24Pass and bullishBodyPass and btcRetPass
bool highGatePass = enableHighWatch and priceGatePass and btcSmaBull and dmiSpread >= 20.0 and dmiSpread[1] >= 20.0

// WATCH 문맥은 다음 시가까지 primitive varip에 보존한다. 실제 펀딩 통과 상태나 포지션은
// 저장하지 않는다.
varip bool pendingWatch = false
varip bool pendingHigh = false
varip int pendingSignalTime = na
varip float pendingSignalClose = na
varip float pendingAtr = na
varip float pendingThreshold = na
varip int pendingSamples = 0
varip int pendingContextScore = 0
varip bool pendingIctSweep = false
varip bool pendingIctFvg = false
varip bool pendingIctOb = false
varip bool pendingIctOte = false
varip bool pendingBbPass = false
varip float pendingRsi = na
varip float pendingDmiSpread = na
varip float pendingAdx = na
varip float pendingVolumeRatio = na
varip bool pendingProfilePass = false
varip string lastAlertEventId = ""

varip int planStartTime = na
varip float planFinalStop = na
varip float planAdd1 = na
varip float planAdd2 = na
varip float planAdd3 = na
varip float planAdd4 = na
varip float planTakeProfit = na

// 이전 확정 WATCH의 다음 60분 시가에서 24h 계획만 만든다. 주문/ENTRY가 아니다.
if barstate.isnew and pendingWatch and time > pendingSignalTime
    float referenceOpen = open
    float stopDistance = pendingAtr * STOP_ATR
    planStartTime := time
    planFinalStop := referenceOpen - stopDistance
    planAdd1 := referenceOpen - stopDistance * 0.20
    planAdd2 := referenceOpen - stopDistance * 0.40
    planAdd3 := referenceOpen - stopDistance * 0.60
    planAdd4 := referenceOpen - stopDistance * 0.80
    planTakeProfit := referenceOpen + stopDistance * TAKE_PROFIT_R
    string setupId = "PV6|" + syminfo.tickerid + "|60|" + str.tostring(pendingSignalTime)
    string eventId = setupId + "|WATCH"
    string watchGrade = pendingHigh ? "HIGH_WATCH" : "A_PLUS_WATCH"
    if enableObservationAlerts and eventId != lastAlertEventId
        alert(f_watchJson(setupId, eventId, watchGrade, pendingSignalTime, pendingSignalClose, referenceOpen, pendingAtr, pendingThreshold, pendingSamples, planFinalStop, planAdd1, planAdd2, planAdd3, planAdd4, planTakeProfit, pendingContextScore, pendingIctSweep, pendingIctFvg, pendingIctOb, pendingIctOte, pendingBbPass, pendingRsi, pendingDmiSpread, pendingAdx, pendingVolumeRatio, pendingProfilePass), alert.freq_all)
        lastAlertEventId := eventId
    pendingWatch := false

if priceGatePass
    pendingWatch := true
    pendingHigh := highGatePass
    pendingSignalTime := time
    pendingSignalClose := close
    pendingAtr := atrEntry
    pendingThreshold := coreThreshold
    pendingSamples := coreSamples
    pendingContextScore := contextScore
    pendingIctSweep := ictSweep
    pendingIctFvg := ictFvg
    pendingIctOb := ictOb
    pendingIctOte := ictOte
    pendingBbPass := bbPass
    pendingRsi := momentum
    pendingDmiSpread := dmiSpread
    pendingAdx := adxValue
    pendingVolumeRatio := volumeRatio
    pendingProfilePass := profilePass

if not na(planStartTime) and time >= planStartTime + PLAN_HOURS * HOUR_MS
    planStartTime := na
    planFinalStop := na
    planAdd1 := na
    planAdd2 := na
    planAdd3 := na
    planAdd4 := na
    planTakeProfit := na

bool planVisible = not na(planStartTime)
plotshape(priceGatePass and not highGatePass, title = "A+ WATCH", style = shape.labelup, location = location.belowbar, color = color.new(color.aqua, 0), textcolor = color.black, size = size.tiny, text = "WATCH")
plotshape(highGatePass, title = "HIGH WATCH", style = shape.labelup, location = location.belowbar, color = color.new(color.lime, 0), textcolor = color.black, size = size.tiny, text = "HIGH WATCH")
plot(planVisible ? planAdd1 : na, "UNVALIDATED ADD PLAN 20%", color = color.new(color.orange, 55), linewidth = 1, style = plot.style_linebr)
plot(planVisible ? planAdd2 : na, "UNVALIDATED ADD PLAN 40%", color = color.new(color.orange, 45), linewidth = 1, style = plot.style_linebr)
plot(planVisible ? planAdd3 : na, "UNVALIDATED ADD PLAN 60%", color = color.new(color.orange, 35), linewidth = 1, style = plot.style_linebr)
plot(planVisible ? planAdd4 : na, "UNVALIDATED ADD PLAN 80%", color = color.new(color.orange, 20), linewidth = 1, style = plot.style_linebr)
plot(planVisible ? planTakeProfit : na, "TP 1R PLAN", color = color.new(color.lime, 0), linewidth = 2, style = plot.style_linebr)
plot(planVisible ? planFinalStop : na, "FINAL SL 7ATR PLAN", color = color.new(color.red, 0), linewidth = 2, style = plot.style_linebr)
